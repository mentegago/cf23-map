      "properties": {
        "name": {
          "const": "search_performed"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "event_edition",
            "app_version",
            "client_event_id",
            "occurred_at_ms",
            "app_run_id",
            "sequence",
            "search_id",
            "source",
            "trigger",
            "resolution",
            "result_count",
            "catalog_result_count",
            "scope"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "event_edition": {
              "const": "comic-frontier-23"
            },
            "app_version": {
              "type": "integer",
              "minimum": 0
            },
            "catalog_version": {
              "type": "integer",
              "minimum": 0
            },
            "client_event_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "occurred_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "app_run_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "search_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "source": {
              "enum": [
                "typed",
                "suggestion",
                "creator_fandom_chip"
              ]
            },
            "trigger": {
              "enum": [
                "settled",
                "submitted",
                "selection",
                "result"
              ]
            },
            "resolution": {
              "enum": [
                "canonical",
                "alias",
                "explicit_selection",
                "creator",
                "booth",
                "ambiguous",
                "unresolved"
              ]
            },
            "fandom_id": {
              "type": "integer",
              "minimum": 0
            },
            "result_count": {
              "type": "integer",
              "minimum": 0
            },
            "catalog_result_count": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "enum": [
                "full_catalog",
                "shared_list",
                "search_result_list"
              ]
            },
            "origin_scope": {
              "enum": [
                "full_catalog",
                "shared_list",
                "search_result_list"
              ]
            },
            "fandom_name": {
              "type": "string",
              "maxLength": 500
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "resolution": {
                    "enum": [
                      "canonical",
                      "alias",
                      "explicit_selection"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "fandom_id"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "fandom_id"
                  ]
                }
              }
            }
          ],
          "dependentRequired": {
            "fandom_name": [
              "fandom_id"
            ]
          }
        }
      }
    },
