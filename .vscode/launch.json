    "version": "0.2.0",
    "configurations": [
        {
            "name": "cf-map-flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "cf-map-flutter-umami",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=UMAMI_WEBSITE_ID=c4e4edfe-be1f-477a-8cbf-702475ab86eb",
